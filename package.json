{
  "name": "ninebike-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build && wrangler deploy --dry-run --outdir dist-worker",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test --trace off",
    "test": "npm run test:unit && npm run test:db && npm run test:integration"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.75.0",
    "jose": "6.1.0",
    "postgres": "3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.4",
    "wrangler": "4.43.0"
  }
}
